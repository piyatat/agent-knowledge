{
  "name": "agent-knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Directory for AI coding agents — look up knowledge, tools and services before acting; curated notes with sources",
  "type": "module",
  "scripts": {
    "index": "node scripts/generate-index.mjs",
    "validate": "node scripts/validate-corpus.mjs",
    "tags": "node scripts/list-tags.mjs",
    "search": "node scripts/search-corpus.mjs",
    "related": "node scripts/list-related.mjs",
    "show": "node scripts/show-entry.mjs",
    "list": "node scripts/list-entries.mjs",
    "count": "node scripts/count-entries.mjs",
    "count:tags": "node scripts/count-entries.mjs --by-tag",
    "directory": "node scripts/generate-directory.mjs",
    "lookup": "node scripts/lookup.mjs",
    "check": "npm run validate && npm run index && npm run directory"
  }
}
