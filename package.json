{
  "name": "agent-knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Lookup corpus for AI coding agents — curated notes with sources",
  "type": "module",
  "scripts": {
    "index": "node scripts/generate-index.mjs",
    "validate": "node scripts/validate-corpus.mjs",
    "tags": "node scripts/list-tags.mjs",
    "search": "node scripts/search-corpus.mjs",
    "related": "node scripts/list-related.mjs",
    "show": "node scripts/show-entry.mjs",
    "list": "node scripts/list-entries.mjs",
